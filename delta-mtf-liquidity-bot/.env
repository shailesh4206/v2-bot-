# Delta Exchange India MTF Liquidity Signal Bot
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────
# DELTA EXCHANGE API (read-only market data)
# Generate API keys at: https://india.delta.exchange/account/api
# Minimum required permission: Read-only (market data)
# DO NOT enable trading permissions for a signal-only bot.
# ─────────────────────────────────────────────
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# ─────────────────────────────────────────────
